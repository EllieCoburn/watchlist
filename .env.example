# Supabase (public keys, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build auth redirect URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Market data (server-only, never NEXT_PUBLIC_)
# mock    - deterministic modeled prices, no keys needed
# finnhub - real-time quotes (free tier: 60 calls/min; daily history from Stooq, intraday from recorded quotes)
#           set MARKET_DATA_API_KEY to your Finnhub token
# alpaca  - Alpaca Market Data (free IEX feed, batch quotes + bars): set the key id and secret below
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
# Daily price history for providers without it (Finnhub free). Polygon's free plan works:
# HISTORY_PROVIDER=polygon
# HISTORY_API_KEY=
# Intraday bar size for the Simulate engines (1 or 5). 1-minute bars need ~2 Polygon calls per ticker.
# INTRADAY_INTERVAL_MINUTES=1
# ALPACA_FEED=iex            # or sip on a paid plan
# ALPACA_TRADING_BASE=https://paper-api.alpaca.markets
