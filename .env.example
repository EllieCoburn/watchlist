# Supabase (public keys, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build auth redirect URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Market data (server-only, never NEXT_PUBLIC_)
# mock   - deterministic modeled prices, no keys needed
# alpaca - Alpaca Market Data (free IEX feed): set the key id and secret below
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
# ALPACA_FEED=iex            # or sip on a paid plan
# ALPACA_TRADING_BASE=https://paper-api.alpaca.markets
